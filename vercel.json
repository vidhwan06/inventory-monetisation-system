{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/frontend/static/$1"
    },
    {
      "source": "/analytics",
      "destination": "/frontend/analytics.html"
    },
    {
      "source": "/analytics.html",
      "destination": "/frontend/analytics.html"
    },
    {
      "source": "/monetization",
      "destination": "/frontend/monetization.html"
    },
    {
      "source": "/monetization.html",
      "destination": "/frontend/monetization.html"
    },
    {
      "source": "/agents",
      "destination": "/frontend/agents.html"
    },
    {
      "source": "/agents.html",
      "destination": "/frontend/agents.html"
    },
    {
      "source": "/settings",
      "destination": "/frontend/settings.html"
    },
    {
      "source": "/settings.html",
      "destination": "/frontend/settings.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/login.html",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/inventory_view",
      "destination": "/frontend/inventory_view.html"
    },
    {
      "source": "/inventory_view.html",
      "destination": "/frontend/inventory_view.html"
    },
    {
      "source": "/orchestration",
      "destination": "/frontend/orchestration.html"
    },
    {
      "source": "/orchestration.html",
      "destination": "/frontend/orchestration.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
